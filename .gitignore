.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.DS_Store

# local library / scratch output — never committed
music/
.tunebox-tmp/

# Xcode's per-user state: window layout, the scheme list, breakpoints. The project file and the
# shared scheme are committed; whose editor was last open is not.
*.xcuserstate
xcuserdata/

# Agent session transcripts and screenshots. Until now these were excluded only by
# .git/info/exclude, which is local to one clone and is not published with the repository — so the
# protection did not travel. They can contain anything that was on screen, including a token.
.agent-shell/
